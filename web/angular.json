{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "pulse-dashboard": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "pulse",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/pulse-main.ts",
            "tsConfig": "tsconfig.application.json",
            "index": {
              "input": "pulse-shell.html",
              "output": "pulse-shell.html"
            },
            "outputPath": {
              "base": "../internal/dashboard/dist",
              "browser": ""
            },
            "deployUrl": "/assets/",
            "outputHashing": "none",
            "styles": ["src/pulse-theme.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "extractLicenses": false,
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "pulse-dashboard:build:production"
            },
            "development": {
              "buildTarget": "pulse-dashboard:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
